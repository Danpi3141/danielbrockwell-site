{
  "name": "danielbrockwell-site",
  "compatibility_date": "2026-11-22",
  // One address only: the custom domain. No workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // Static files, plus one small script that answers range requests for the clips (Safari needs them).
  "main": "worker/index.js",
  "assets": {
    "directory": "./_site/",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/video/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // The site lives at the bare domain. www is attached too, so it has a certificate and a
  // DNS record; a Redirect Rule on the zone sends it to the bare domain before the Worker runs.
  "routes": [
    { "pattern": "danielbrockwell.uk", "custom_domain": true },
    { "pattern": "www.danielbrockwell.uk", "custom_domain": true }
  ]
}
