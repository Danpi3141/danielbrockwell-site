{#- Shared components, as Nunjucks macros. Import with {% import "components/ui.njk" as ui %}. -#}

{% macro badge(status) -%}
<span class="badge badge-{{ status }}">{{ status | statusLabel }}</span>
{%- endmacro %}

{#- models: the entry's models object; list: models.json -#}
{% macro modelStrip(models, list) -%}
<span class="sr">Models:</span><ul class="models">
  {%- for m in list %}
  {%- set st = models[m.id].state if models and models[m.id] else "untested" %}
  <li class="key key-{{ st }}">{{ m.name }}<span class="sr">: {{ "works" if st == "works" else ("not supported" if st == "no" else "untested") }}</span></li>
  {%- endfor %}
</ul>
{%- endmacro %}

{#- An LCD panel holding up to four lines of text -#}
{% macro lcdText(lines, label) -%}
<div class="lcd"{% if label %} role="img" aria-label="{{ label }}"{% endif %}><pre class="lcd-text"{% if label %} aria-hidden="true"{% endif %}>{% for l in lines %}{{ l }}{% if not loop.last %}
{% endif %}{% endfor %}</pre></div>
{%- endmacro %}

{#- An LCD panel holding a real screenshot, drawn at half its file size (2 screen pixels a dot) -#}
{% macro lcdShot(shot, lazy) -%}
{%- set sz = shot.src | pngSize -%}
<div class="lcd lcd-shot"><img src="{{ shot.src }}" alt="{{ shot.alt }}" width="{{ sz.width / 2 }}" height="{{ sz.height / 2 }}"{% if lazy %} loading="lazy"{% endif %}></div>
{%- endmacro %}

{% macro programCard(p, models) -%}
{#- Three screen panels; the Psion overview's screen filter shows one (CSS only, no script):
    all: the first screenshot; two-line: a two-line screenshot, or the apology when no two-line
    model runs it; four-line: likewise. Hidden panels' images are lazy, so they load only when shown. -#}
{%- set two = p.data.models | screenSupport(2) %}
{%- set four = p.data.models | screenSupport(4) %}
{%- set first = p.data.screenshots[0] if (p.data.screenshots and p.data.screenshots.length) else none %}
{%- set s2 = p.data.screenshots | shotFor(2) %}
{%- set s4 = p.data.screenshots | shotFor(4) %}
{%- set t = (p.data.lcd_name or p.data.title) | upper | truncate(20, true, "") %}
<article class="card" data-two="{{ two }}" data-four="{{ four }}">
  <div class="shot shot-all">{% if first %}{{ lcdShot(first, true) }}{% else %}{{ lcdText(["", t | center(20), "", ""], "") }}{% endif %}</div>
  <div class="shot shot-2">
    {%- if two == "no" %}{{ lcdShot({ src: "/assets/img/psion/sorry-lz-only.png", alt: "Organiser screen: Sorry! This game needs the 4-line screen of an LZ or LZ64 only" }, true) }}
    {%- elif s2 %}{{ lcdShot(s2, true) }}
    {%- elif first %}{{ lcdShot(first, true) }}
    {%- else %}{{ lcdText(["", t | center(20), "", ""], "") }}{% endif -%}
  </div>
  <div class="shot shot-4">
    {%- if four == "no" %}{{ lcdText(["       SORRY!", " THIS GAME IS FOR", " THE TWO-LINE CM,", " XP AND LA ONLY"], "Sorry! This game is for the two-line CM, XP and LA only") }}
    {%- elif s4 %}{{ lcdShot(s4, true) }}
    {%- elif first %}{{ lcdShot(first, true) }}
    {%- else %}{{ lcdText(["", t | center(20), "", ""], "") }}{% endif -%}
  </div>
  <h3 class="card-title"><a href="{{ p.url }}">{{ p.data.title }}</a></h3>
  <p class="card-summary">{{ p.data.summary }}</p>
  <div class="card-meta">{{ badge(p.data.status) }}{% if p.data.pack %}<span class="mono small">{{ p.data.pack }} pack</span>{% endif %}</div>
  {{ modelStrip(p.data.models, models) }}
  <p class="card-actions">
    <a class="button button-secondary" href="{{ p.url }}">Details<span class="sr"> about {{ p.data.title }}</span></a>
    {%- set builds = p.data.files | filesOfKind("psion") %}
    {%- if not builds.length %}{% set builds = p.data.files | filesOfKind("build") %}{% endif %}
    {%- if builds.length %}
    {%- set f = builds | last %}
    <a class="button" href="{{ p.data.downloadDir }}{{ f.file }}" download>Download<span class="sr"> {{ p.data.title }} {{ f.version }}</span></a>
    {%- endif %}
  </p>
</article>
{%- endmacro %}

{% macro projectCard(p) -%}
<article class="card">
  {%- if p.data.screenshots and p.data.screenshots.length %}
  {%- set sz = p.data.screenshots[0].src | pngSize %}
  <img class="frame" src="{{ p.data.screenshots[0].src }}" alt="{{ p.data.screenshots[0].alt }}" width="{{ sz.width }}" height="{{ sz.height }}" loading="lazy">
  {%- endif %}
  <h3 class="card-title"><a href="{{ p.url }}">{{ p.data.title }}</a></h3>
  <p class="card-summary">{{ p.data.summary }}</p>
  <div class="card-meta">{{ badge(p.data.status) }}</div>
</article>
{%- endmacro %}

{#- The main download: name, version, bytes, date, checksum, button -#}
{% macro fileRow(f, dir, label, buttonText) -%}
{%- set rel = dir + f.file -%}
<div class="dl-file">
  <h3 class="dl-label">{{ label }}</h3>
  <dl class="dl-facts">
    <dt>File</dt><dd><code>{{ f.file }}</code></dd>
    <dt>Version</dt><dd>{{ f.version }}</dd>
    <dt>Size</dt><dd class="mono">{{ rel | fileSize | bytes }} bytes</dd>
    <dt>Date</dt><dd><time datetime="{{ f.date | dateIso }}">{{ f.date | dateLong }}</time></dd>
    <dt>SHA-256</dt><dd><code class="hash">{{ rel | sha256 }}</code></dd>
  </dl>
  <p><a class="button" href="{{ rel }}" download>{{ buttonText }}</a></p>
</div>
{%- endmacro %}

{#- Another download, one compact row: what it is, file, bytes, checksum, button -#}
{% macro fileAlt(f, dir, label) -%}
{%- set rel = dir + f.file -%}
<li class="dl-alt">
  <div>
    <p class="dl-alt-name">{{ label }}</p>
    <p class="small"><code>{{ f.file }}</code> · <span class="mono">{{ rel | fileSize | bytes }} bytes</span></p>
    <p class="small">SHA-256 <code class="hash">{{ rel | sha256 }}</code></p>
  </div>
  <a class="chip" href="{{ rel }}" download>Download<span class="sr"> {{ label }}</span></a>
</li>
{%- endmacro %}

{#- The download box: the newest version's Organiser files (or, without them, the build), then the
    other files of that version, then older versions -#}
{% macro downloadBox(d) -%}
<section class="download-box" aria-labelledby="dl-h">
  <h2 id="dl-h">Download</h2>
  {%- if d.files and d.files.length %}
  {%- set newest = d.files | newestVersion %}
  {%- set cur = d.files | onlyVersion(newest) %}
  {%- set main = (cur | filesOfKind("psion") | first) or (cur | filesOfKind("build") | first) %}
  {{ fileRow(main, d.downloadDir, "Organiser files (zip)" if main.kind == "psion" else (d.buildLabel or "Build: pack image"), "Download") }}
  {% if d.needs %}<p class="dl-needs">{{ d.needs }}</p>{% endif %}
  {%- set alts = [] %}
  {%- for f in cur %}{% if f.file != main.file %}{% set alts = (alts | concat(f)) %}{% endif %}{% endfor %}
  {%- if alts.length %}
  <h3 class="dl-also">Also</h3>
  <ul class="dl-alts">
    {%- for f in alts %}
    {{ fileAlt(f, d.downloadDir, "Pack image (.opk), for emulators and pack writers" if f.kind == "build" else ("Source + build (zip)" if f.kind == "source" else "Organiser files (zip)")) }}
    {%- endfor %}
  </ul>
  {%- endif %}
  {% if d.licence %}<p class="small">Licence: {{ d.licence }}.</p>{% endif %}
  {%- set older = d.files | notVersion(newest) %}
  {%- if older.length %}
  <h3>Older versions</h3>
  <ul class="older">
    {%- for f in older | reverse %}
    <li><a href="{{ d.downloadDir }}{{ f.file }}" download><code>{{ f.file }}</code></a>, {{ (d.downloadDir + f.file) | fileSize | bytes }} bytes, {{ f.date | dateLong }}</li>
    {%- endfor %}
  </ul>
  {%- endif %}
  {%- else %}
  <p>Not released yet.</p>
  {%- endif %}
</section>
{%- endmacro %}

{#- Pack size as an LCD capacity meter: six segments, 8K to 256K, lit from the size needed up -#}
{% macro packMeter(pack) -%}
{%- set need = pack | replace("K", "") | int -%}
{%- set sizes = [8, 16, 32, 64, 128, 256] -%}
{%- set fits = [] -%}{%- for k in sizes %}{% if k >= need %}{% set fits = (fits | concat(k ~ "K")) %}{% endif %}{% endfor -%}
<div class="pack-meter" role="img" aria-label="Needs a {{ pack }} pack or larger. Fits: {{ fits | join(', ') }}">
  <div class="pm-screen" aria-hidden="true">
    <p class="pm-title">PACK {{ pack }}{% if need < 256 %} OR MORE{% endif %}</p>
    <div class="pm-row">{% for k in sizes %}<span class="pm-seg{% if k >= need %} pm-on{% endif %}"></span>{% endfor %}</div>
    <div class="pm-row pm-labels">{% for k in sizes %}<span>{{ k }}K</span>{% endfor %}</div>
  </div>
</div>
{%- endmacro %}
