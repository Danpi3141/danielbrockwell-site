---
layout: layouts/base.njk
title: Psion Organiser II programs
section: psion
description: "Games and utilities for the Psion Organiser II: pack images to download, source, model compatibility and manuals."
---
{% import "components/ui.njk" as ui %}
<div class="wrap psion-list">
  <h1>{{ title }}</h1>
  <div class="prose">
    <p>Games and utilities for the Psion Organiser II, written in OPL and 6303 machine code. Each one comes as a pack image you can run in an emulator or load onto a real Organiser; released programs also come with their source and build as a zip.</p>
    <p>New to this? Start with <a href="/psion/getting-started/">Getting started</a>.</p>
  </div>
  <nav aria-label="On this page"><ul class="jump">
    <li><a href="#games">Games</a></li>
    <li><a href="#utilities">Utilities</a></li>
    <li><a href="#all-downloads">All downloads</a></li>
  </ul></nav>

  <fieldset class="screen-filter">
    <legend>Show for</legend>
    <input class="sr" type="radio" name="screen" id="scr-all" value="all" checked><label for="scr-all">Every model</label>
    <input class="sr" type="radio" name="screen" id="scr-2" value="2"><label for="scr-2">Two-line <span class="small">CM, XP, LA</span></label>
    <input class="sr" type="radio" name="screen" id="scr-4" value="4"><label for="scr-4">Four-line <span class="small">LZ, LZ64</span></label>
  </fieldset>

  {%- for g in [["games", "Games", "game"], ["utilities", "Utilities", "utility"]] %}
  <h2 id="{{ g[0] }}">{{ g[1] }}</h2>
  <div class="grid">
    {%- for p in collections.programs | byCategory(g[2]) %}
    {{ ui.programCard(p, models_list) }}
    {%- endfor %}
  </div>
  {%- endfor %}

  <hr class="rule">
  <h2 id="all-downloads">All downloads</h2>
  <div class="table-scroll">
  <table>
    <thead><tr><th scope="col">Program</th><th scope="col">Version</th><th scope="col">Models</th><th scope="col">Pack size</th><th scope="col">File</th><th scope="col">Updated</th></tr></thead>
    <tbody>
      {%- for p in collections.programs | withFiles %}
      {%- for f in p.data.files %}
      <tr data-two="{{ p.data.models | screenSupport(2) }}" data-four="{{ p.data.models | screenSupport(4) }}">
        <td><a href="{{ p.url }}">{{ p.data.title }}</a></td>
        <td>{{ f.version }}</td>
        <td>{% for m in models_list %}{% if p.data.models[m.id].state == "works" %}{{ m.name }} {% endif %}{% endfor %}</td>
        <td>{{ p.data.pack }}</td>
        <td><a href="{{ p.data.downloadDir }}{{ f.file }}" download><code>{{ f.file }}</code></a><br><span class="small">{{ "Source + build" if f.kind == "source" else "Build" }}, {{ (p.data.downloadDir + f.file) | fileSize | bytes }} bytes</span></td>
        <td><time datetime="{{ f.date | dateIso }}">{{ f.date | dateLong }}</time></td>
      </tr>
      {%- endfor %}
      {%- endfor %}
    </tbody>
  </table>
  </div>
</div>
