/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/downloads/psion/:slug/:file
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename=":file"

/downloads/cv/:file
  Content-Disposition: attachment; filename=":file"

/llms.txt
  Content-Type: text/plain; charset=utf-8

/feed.xml
  Content-Type: application/rss+xml; charset=utf-8

/styleguide/*
  X-Robots-Tag: noindex
